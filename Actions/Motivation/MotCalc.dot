digraph MotCalc {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#dbeafe",
        color="#1d4ed8", fontname="Helvetica", fontsize=11, fontcolor="#1e3a8a"];
  edge [color="#334155"];

  // Labels = subsection titles. Edge A -> B means B imports A.
  EpistemicModel [label="Epistemic model"];
  GladModel [label="Gladness model"];
  SemImp [label="Semantic implications"];
  SampledSemImp [label="Sampled SemImp bundle"];
  PreferWantCan [label="Prefer / want / can"];

  EpistemicModel -> GladModel;
  EpistemicModel -> SemImp;
  EpistemicModel -> PreferWantCan;
  GladModel -> SemImp;
  SemImp -> SampledSemImp;
}
