digraph Arrow {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#dbeafe",
        color="#1d4ed8", fontname="Helvetica", fontsize=11, fontcolor="#1e3a8a"];
  edge [color="#334155"];

  TotalPreorder [label="TotalPreorder"];
  Arrow [label="Arrow"];
  CompulsiveOrHedonistic [label="CompulsiveOrHedonistic"];
  BlindObedience [label="BlindObedience"];
  NeuroticAllOrNothing [label="NeuroticAllOrNothing"];

  Arrow -> TotalPreorder;
  CompulsiveOrHedonistic -> Arrow;
  BlindObedience -> Arrow;
  NeuroticAllOrNothing -> Arrow;
}
