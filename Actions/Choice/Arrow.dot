digraph Arrow {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#dbeafe",
        color="#1d4ed8", fontname="Helvetica", fontsize=11, fontcolor="#1e3a8a"];
  edge [color="#334155"];

  // Labels = subsection titles. Edge A -> B means B imports A.
  TotalPreorder [label="Total preorder"];
  Arrow [label="Arrow postulates"];
  prefer [label="Prefer ranking"];
  scale1Dictator [label="Scale-1 dictator"];
  scale2Dictator [label="Scale-2 dictator"];
  ArrowPostulates2 [label="Arrow postulates package"];
  CompulsiveOrHedonistic [label="Compulsive or hedonistic"];
  BlindObedience [label="Blind obedience"];
  NeuroticAllOrNothing [label="Neurotic all-or-nothing"];

  TotalPreorder -> Arrow;
  Arrow -> prefer;
  prefer -> scale1Dictator;
  prefer -> scale2Dictator;
  scale1Dictator -> ArrowPostulates2;
  scale2Dictator -> ArrowPostulates2;
  scale1Dictator -> CompulsiveOrHedonistic;
  scale2Dictator -> CompulsiveOrHedonistic;
  Arrow -> BlindObedience;
  Arrow -> NeuroticAllOrNothing;
}
