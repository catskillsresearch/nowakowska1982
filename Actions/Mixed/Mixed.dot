digraph Mixed {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#dbeafe",
        color="#1d4ed8", fontname="Helvetica", fontsize=11, fontcolor="#1e3a8a"];
  edge [color="#334155"];

  // Labels = subsection titles. Edge A -> B means B imports A.
  NonParasitic [label="Non-parasitic strings"];
  RinvSet [label="Inverse images for sets"];
  MixedSystem [label="Mixed system"];
  pi [label="Projection pi"];
  LM [label="Mixed language"];
  VerbalPart [label="Verbal part"];
  MotivationalConsistency [label="Motivational consistency"];
  Realizes [label="Realization of timed lists"];
  Satisfiable [label="Satisfiable systems"];
  ConsistentWith [label="Consistent with utterance"];
  Psi [label="Psi of utterance sets"];
  PromiseBridge [label="Promise bridge"];

  NonParasitic -> MixedSystem;
  RinvSet -> MixedSystem;
  MixedSystem -> pi;
  pi -> LM;
  LM -> VerbalPart;
  VerbalPart -> MotivationalConsistency;
  VerbalPart -> Realizes;
  MotivationalConsistency -> Satisfiable;
  Realizes -> Satisfiable;
  MixedSystem -> ConsistentWith;
  ConsistentWith -> Psi;
  MotivationalConsistency -> Psi;
  MixedSystem -> PromiseBridge;
}
