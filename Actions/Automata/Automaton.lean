module

public import Actions.ActionSystem
import Mathlib.Tactic

@[expose] public section

/-!
# Automaton interpretation of action theory

Nowakowska (1982), §13: automaton
`⟨U, B, Θ, D, #, τ, π⟩` (tuple letters normalized to match prose `τ`, `π`).
Transition uses stimulus `b`, correcting the printed `nⱼ₋₁` typo.
-/

namespace Actions

/-- Deterministic action automaton with admissibility function `τ`
and transition map `π`. -/
structure ActionAutomaton where
  /-- Internal states. -/
  U : Type*
  /-- Stimuli. -/
  B : Type*
  /-- Null stimulus. -/
  Θ : B
  /-- Elementary actions. -/
  D : Type*
  /-- Pause action. -/
  pause : D
  /-- Admissible actions in a state/stimulus context (nonempty). -/
  τ : U → B → Set D
  τ_nonempty : ∀ u b, (τ u b).Nonempty
  /-- Transition map. -/
  π : U → B → D → U

namespace ActionAutomaton

variable (M : ActionAutomaton)

/-- A string `d₁…dₙ` is admissible from `(u₀,b₀)` if each step is in `τ`
and states follow `π` (with stimuli `bⱼ`). -/
inductive Admissible : M.U → M.B → List M.D → Prop where
  | nil (u : M.U) (b : M.B) : Admissible u b []
  | cons {u : M.U} {b : M.B} {d : M.D} {ds : List M.D} {b' : M.B}
      (hd : d ∈ M.τ u b)
      (tail : Admissible (M.π u b d) b' ds) :
      Admissible u b (d :: ds)

/-- Language of actions generated by the automaton from a start state. -/
def language (u₀ : M.U) (b₀ : M.B) : Set (List M.D) :=
  { ds | M.Admissible u₀ b₀ ds }

theorem nil_mem_language (u₀ : M.U) (b₀ : M.B) :
    ([] : List M.D) ∈ M.language u₀ b₀ :=
  Admissible.nil u₀ b₀

/-- One-step: if `d` is admissible at `(u,b)`, the singleton string is admissible. -/
theorem singleton_admissible {u : M.U} {b : M.B} {d : M.D}
    (hd : d ∈ M.τ u b) : M.Admissible u b [d] :=
  Admissible.cons hd (Admissible.nil (M.π u b d) b)

/-- Corrected recurrence: next state uses prior stimulus `b`, not a time index. -/
def nextState (u : M.U) (b : M.B) (d : M.D) : M.U :=
  M.π u b d

theorem nextState_eq (u : M.U) (b : M.B) (d : M.D) :
    M.nextState u b d = M.π u b d :=
  rfl

/-- One cons-step uses `nextState` (stimulus-indexed `π`), not a time index. -/
theorem admissible_cons_nextState {u : M.U} {b b' : M.B} {d : M.D}
    {ds : List M.D} (hd : d ∈ M.τ u b)
    (tail : M.Admissible (M.nextState u b d) b' ds) :
    M.Admissible u b (d :: ds) :=
  Admissible.cons hd (by simpa [nextState] using tail)

/-- Membership in `language` is exactly inductive admissibility. -/
theorem mem_language_iff (u₀ : M.U) (b₀ : M.B) (ds : List M.D) :
    ds ∈ M.language u₀ b₀ ↔ M.Admissible u₀ b₀ ds :=
  Iff.rfl

end ActionAutomaton

end Actions
