digraph Promise {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#dbeafe",
        color="#1d4ed8", fontname="Helvetica", fontsize=11, fontcolor="#1e3a8a"];
  edge [color="#334155"];

  // Labels = subsection titles. Edge A -> B means B imports A.
  minφ [label="Minimum elementary duration"];
  stringDuration [label="String duration"];
  HatT [label="Minimal fulfilling strings"];
  HatU [label="First offenses"];
  promiseSuffixLang [label="Promise suffix language"];
  LanguageHypotheses [label="Language hypotheses"];
  offenseSuffixLang [label="Offense suffix language"];
  PromiseClosed [label="Promise closed"];
  OffenseClosed [label="Offense closed"];

  minφ -> stringDuration;
  stringDuration -> HatT;
  stringDuration -> HatU;
  HatT -> promiseSuffixLang;
  HatU -> offenseSuffixLang;
  HatT -> PromiseClosed;
  promiseSuffixLang -> PromiseClosed;
  LanguageHypotheses -> PromiseClosed;
  HatU -> OffenseClosed;
  offenseSuffixLang -> OffenseClosed;
  LanguageHypotheses -> OffenseClosed;
}
